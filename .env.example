# Production (production.yml). Development needs none of these.

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated. Also used for CSRF_TRUSTED_ORIGINS and the healthcheck.
DJANGO_ALLOWED_HOSTS=genossenschaftsmatrix.superservice-international.com

# Hostname in the Traefik labels. Only set it to try the stack under a
# temporary hostname before the DNS switchover.
# SITE_HOST=next.genossenschaftsmatrix.superservice-international.com
